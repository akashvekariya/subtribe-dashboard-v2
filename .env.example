# Environment Configuration Example
# Copy this to .env.local for local development

# Backend API Configuration (REQUIRED)
# NEXT_PUBLIC_API_URL=https://api-staging.thesubtribe.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public App URL (for generating job application links)
# Local development: Use the port where the app/ is running
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Production: Use your production app domain
# NEXT_PUBLIC_APP_URL=https://app.thesubtribe.com

# Public site URL used for canonical links and the sitemap (optional)
# Defaults to https://thesubtribe.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Set to true to silence the client and server logger (optional)
DISABLE_LOGGING=false

# Note: API uses serverless (Cloud Run) - initial request may have cold start delay
