# --- Core Settings ---

# Normalize line endings (always LF)
* text=auto eol=lf

# Ensure scripts are always LF
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# --- GitHub Linguist / Repo Hygiene ---

# Ignore build outputs and dependencies from language stats
node_modules/* linguist-vendored
.next/* linguist-vendored
dist/* linguist-vendored
out/* linguist-vendored
build/* linguist-vendored

# Ignore lockfiles for stats
pnpm-lock.yaml linguist-generated
package-lock.json linguist-generated
yarn.lock linguist-generated

# Ignore compiled files
*.min.js linguist-generated
*.min.css linguist-generated

# --- Lockfile / JSON / Config Diffing ---

# Treat lockfiles as JSON for better diffs
pnpm-lock.yaml linguist-language=JSON
yarn.lock linguist-language=JSON
package-lock.json linguist-language=JSON

# Treat JSON & config files as text
*.json text
*.jsonc text
*.yml text
*.yaml text
*.toml text

# --- Documentation ---

# Ensure Markdown & docs are always text
*.md text
*.mdx text
docs/** text

# --- Images / Binaries ---

# Binary files (prevent diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
