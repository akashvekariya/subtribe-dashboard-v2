#!/bin/bash
#
# Git pre-commit hook for Frontend
# Runs linting, formatting, and type checks before allowing commit
# Prevents broken code from reaching GitHub Actions
#

set -e

echo "🔍 Running pre-commit checks..."
echo ""

# 1. ESLint
echo "📝 Step 1/3: Running ESLint..."
if pnpm run lint; then
    echo "   ✅ Linting passed"
else
    echo ""
    echo "❌ Linting failed! Fix errors before committing."
    echo "   Run: pnpm run lint"
    echo "   Auto-fix: pnpm run lint:fix"
    exit 1
fi
echo ""

# 2. Auto-format code with Prettier
echo "🎨 Step 2/3: Auto-formatting code with Prettier..."
pnpm run format > /dev/null 2>&1
echo "   ✅ Code formatted"
echo ""

# 3. TypeScript type checking
echo "🔎 Step 3/3: Running TypeScript type checker..."
if pnpm run typecheck; then
    echo "   ✅ Type checking passed"
else
    echo ""
    echo "❌ Type errors found! Fix type errors before committing."
    echo "   Run: pnpm run typecheck"
    exit 1
fi

echo ""
echo "✅ All pre-commit checks passed!"
echo "💾 Proceeding with commit..."
echo ""

exit 0
